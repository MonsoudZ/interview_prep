# This example contains NO usable credentials. Store real values only on the host,
# outside source control, readable only by root and the dedicated service account.
INTERVIEW_CONTROL_PLANE_URL=https://YOUR_PRIVATE_CONTROL_PLANE
INTERVIEW_WORKER_ID=REPLACE_WITH_CANONICAL_UUID
INTERVIEW_WORKER_IMAGE=sha256:REPLACE_WITH_BUILT_IMAGE_ID
INTERVIEW_WORKER_BRIDGE_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
INTERVIEW_WORKER_SIGNING_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_BYTES
