{
  "name": "interview-studio-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node frontend/build.mjs",
    "test": "node --test test/frontend/*.test.mjs",
    "format": "prettier --write public/*.js public/app.css frontend/ test/frontend/",
    "format:check": "prettier --check public/*.js public/app.css frontend/ test/frontend/"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.14",
    "codemirror": "6.0.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "prettier": "3.9.10"
  }
}
